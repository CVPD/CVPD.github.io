@InProceedings{iglesias2027explainable,
author="Aitor Iglesias
and Ruben Naranjo
and Nerea Aranjuelo
and Ignacio Arganda-Carreras
and Marcos Nieto",
editor="Sintorn, Ida-Maria
and Pal, Umapada
and Lu, Shijian",
title="Explainable Artificial Intelligence (XAI) for Point Cloud Perception inAutonomous Driving: A Survey",
booktitle="Pattern Recognition. ICPR 2026 International Workshops",
year="2027",
publisher="Springer Nature Switzerland",
address="Cham",
pages="494--508",
abstract="This survey provides the first comprehensive review of Explainable Artificial Intelligence (XAI) methods applied to point cloud-based perception in autonomous driving. Although Deep Learning has significantly advanced 3D perception tasks such as object detection and semantic segmentation, the opacity of these models is a challenges for safety-critical systems. To address this, the paper examines existing XAI for point cloud approaches and categorizes them based on a previously defined XAI-specific taxonomy. The review highlights the challenges and limitations of the current state of the art, which includes the lack of standardized evaluation metrics and the limited number of XAI methods tailored specifically to point cloud data in the field of autonomous driving. In this work, we also outline future research directions, emphasizing the need for point cloud--native XAI techniques, stronger validation frameworks, and the integration of emerging vision-language models to enhance explainability and reliability in autonomous driving.",
isbn="978-3-032-39388-3",
doi="10.1007/978-3-032-39388-3_35",
url="https://link.springer.com/chapter/10.1007/978-3-032-39388-3_35",
keywords="Explainable AI, Artificial intelligence, Survey, Point cloud, Computer Vision,Autonomous Driving",
}

@INPROCEEDINGS{ali2026from,
  author={Mohamad Abou Ali and Fadi Dornaika and Ignacio Arganda-Carreras and Hussein Ali and Abdallah Kassem},
  booktitle={2026 IEEE 5th International Multidisciplinary Conference on Engineering Technology (IMCET)}, 
  title={From Binary to Multi-Class: Benchmarking AutoGluon Against Classical Machine Learning for Diabetes Prediction and the Rise of Agentic Clinical AI}, 
  year={2026},
  volume={},
  number={},
  pages={36-41},
  abstract={The integration of automated machine learning (AutoML) into clinical workflows promises to democratize advanced predictive analytics, yet rigorous benchmarks against state-of-the-art (SOTA) classical machine learning pipelines remain limited. This study presents a comprehensive evaluation of AutoGluon against classically engineered ML approaches meticulously engineered for the prediction of diabetes risk, a global health priority that affects more than 537 million adults around the world. We conduct two complementary experiments: (1) binary diabetes classification on a 100,000-sample data set, and (2) a novel three-class risk stratification framework (Normal, Pre-Diabetes, Diabetes) aligned with American Diabetes Association (ADA) 2025 guidelines, establishing a new benchmark for pre-diabetes detection. Results demonstrate that AutoML achieves performance parity with classical SOTA models (AUC: 0.9790 vs. 0.9791) while reducing the development effort by 93% and substantially lowering the requirements of expert intervention. A discordance analysis reveals that rare model disagreements are concentrated in clinically ambiguous borderline cases, reflecting areas of inherent diagnostic uncertainty rather than model failure. Beyond benchmarking, we conceptualize AutoML as the computational core of Agentic Clinical AI Systems—autonomous, adaptive architectures capable of continuous learning, explainability, and real-world clinical deployment. Collectively, these findings support AutoML-powered agentic systems as a scalable and practical pathway for high-quality diabetes prediction across diverse healthcare settings.},
  keywords={Feedback,Circuits,Computer networks,Internet,Radio frequency,Storage area networks,Protocols,Communication systems,HTTP,Radio communication,Diabetes Prediction,AutoML,Automated Machine Learning,Classical Machine Learning,Agentic AI,Clinical Decision Support,Risk Stratification,Pre-diabetes Detection,ADA Guidelines,Benchmark Study},
  doi={10.1109/IMCET69180.2026.11503779},
  url={https://ieeexplore.ieee.org/abstract/document/11503779},
  ISSN={},
  month={April},
  }

@INPROCEEDINGS{ali2026automl,
  author={Mohamad Abou Ali and Fadi Dornaika and Ignacio Arganda-Carreras and Hussein Ali and Abdallah Kassem},
  booktitle={2026 IEEE 5th International Multidisciplinary Conference on Engineering Technology (IMCET)}, 
  title={AutoML vs Classical Machine Learning: A Comparative Analysis Using Diabetes Prediction as a Case Study}, 
  year={2026},
  volume={},
  number={},
  pages={30-35},
  abstract={Automated machine learning (AutoML) is transforming how predictive models are developed, yet its real-world performance compared to expert-engineered pipelines remains underexplored. This study systematically evaluates AutoGluon AutoML against classical machine learning using diabetes prediction as a representative clinical case. Across binary (100,000 Kaggle samples) and 3-class ADA 2025 experiments, AutoML matched expert pipelines in predictive accuracy (AUC0.9790 vs 0.9791) while reducing development effort by 93%, requiring minimal technical expertise. Statistical analysis confirms no significant performance difference. Beyond efficiency gains, AutoML's automated pipeline construction demonstrates potential for integration into emerging Agentic AI systems. These findings position AutoML as a practical, scalable, and democratizing tool for clinical decision support and broader data science applications, highlighting both immediate utility and future avenues for autonomous, high-impact predictive modeling.},
  keywords={Radio broadcasting,Frequency modulation,Internet,Computer networks,Communication systems,Storage area networks,Protocols,Modulation,HTTP,Radio broadcasting,AutoML,Classical Machine Learning,Diabetes Prediction,Agentic AI,Automated Feature Engineering,Model Selection,Hyperparameter Optimization,Clinical Decision Support},
  doi={10.1109/IMCET69180.2026.11503719},
  url={https://ieeexplore.ieee.org/abstract/document/11503719},
  ISSN={},
  month={April},}


