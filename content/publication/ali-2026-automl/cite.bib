@inproceedings{ali2026automl,
 abstract = {Automated machine learning (AutoML) is transforming how predictive models are developed, yet its real-world performance compared to expert-engineered pipelines remains underexplored. This study systematically evaluates AutoGluon AutoML against classical machine learning using diabetes prediction as a representative clinical case. Across binary (100,000 Kaggle samples) and 3-class ADA 2025 experiments, AutoML matched expert pipelines in predictive accuracy (AUC0.9790 vs 0.9791) while reducing development effort by 93%, requiring minimal technical expertise. Statistical analysis confirms no significant performance difference. Beyond efficiency gains, AutoML's automated pipeline construction demonstrates potential for integration into emerging Agentic AI systems. These findings position AutoML as a practical, scalable, and democratizing tool for clinical decision support and broader data science applications, highlighting both immediate utility and future avenues for autonomous, high-impact predictive modeling.},
 author = {Mohamad Abou Ali and Fadi Dornaika and Ignacio Arganda-Carreras and Hussein Ali and Abdallah Kassem},
 booktitle = {2026 IEEE 5th International Multidisciplinary Conference on Engineering Technology (IMCET)},
 doi = {10.1109/IMCET69180.2026.11503719},
 issn = {},
 keywords = {Radio broadcasting,Frequency modulation,Internet,Computer networks,Communication systems,Storage area networks,Protocols,Modulation,HTTP,Radio broadcasting,AutoML,Classical Machine Learning,Diabetes Prediction,Agentic AI,Automated Feature Engineering,Model Selection,Hyperparameter Optimization,Clinical Decision Support},
 month = {April},
 number = {},
 pages = {30-35},
 title = {AutoML vs Classical Machine Learning: A Comparative Analysis Using Diabetes Prediction as a Case Study},
 url = {https://ieeexplore.ieee.org/abstract/document/11503719},
